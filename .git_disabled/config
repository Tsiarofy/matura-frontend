[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = git@github.com:Tsiarofy/matura-frontend.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "dev"]
	remote = origin
	merge = refs/heads/dev
[branch "windsurf"]
	remote = origin
	merge = refs/heads/windsurf
	vscode-merge-base = origin/dev
